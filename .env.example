# Copy this file to .env and fill in your values
# DO NOT commit .env — it is gitignored

# Your deployed backend API base URL (no trailing slash, no /api)
# For local dev: http://localhost:5000
# For production: https://your-api.onrender.com
VITE_API_URL=https://ryoit-api.onrender.com

# Google OAuth Client ID from https://console.cloud.google.com/
# Add http://localhost:5173 and your Netlify URL to Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Google AdSense Configuration
VITE_ADSENSE_PUBLISHER_ID=ca-pub-1190706248323157
VITE_ADSENSE_ENABLED=true
