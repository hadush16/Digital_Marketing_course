# Copy this file to .env and fill in your values
# DO NOT commit .env — it is gitignored

# Your deployed backend API base URL (no trailing slash, no /api)
# For local dev: http://localhost:5000
# For production: https://your-api.onrender.com
VITE_API_URL=https://ryoit-api.onrender.com

# Google OAuth Web Client ID from https://console.cloud.google.com/
# Add http://localhost:5173 and your Netlify/Vercel URL to Authorized JavaScript Origins
# Current Web Client ID (project: Ryoit Platform):
VITE_GOOGLE_CLIENT_ID=853536644056-goqjj7s2olijf7ffrqbb4nkrg04nq744.apps.googleusercontent.com
